<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경 색 (흰색 또는 투명) -->
    <solid android:color="#FFFFFF" />

    <!-- 테두리 -->
    <stroke
        android:width="1dp"
        android:color="#CCCCCC" />

    <!-- 모서리 둥글게 -->
    <corners android:radius="12dp" />

    <!-- 안쪽 여백 (선택사항) -->
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp" />
</shape>