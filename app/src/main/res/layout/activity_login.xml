<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 상단 이미지 -->
    <ImageView
        android:id="@+id/mainImage"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:contentDescription="main image"
        android:src="@drawable/main" />

    <!-- 스크롤 가능한 콘텐츠 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="30dp"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ClotheSUp"
                android:textSize="40sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/loveyalikeasister_regular" />

            <!-- 설명 -->
            <TextView
                android:id="@+id/appSubtitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="매일 입고 싶은 옷, 매일 업데이트"
                android:textSize="14sp"
                android:textColor="#444444" />

            <TextView
                android:id="@+id/appSubtitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=": 매일이 다른 기본처럼 입고 싶은 옷도 다르니까"
                android:textSize="14sp"
                android:textColor="#444444"
                android:layout_marginBottom="24dp" />

            <!-- 아이디 입력 -->
            <EditText
                android:id="@+id/idEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" 아이디 입력"
                android:inputType="textEmailAddress"
                android:background="@android:color/transparent"
                android:paddingBottom="8dp"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_marginBottom="4dp"
                android:drawablePadding="10dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#000000" />

            <!-- 비밀번호 입력 -->
            <EditText
                android:id="@+id/pwEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=" 비밀번호 입력"
                android:inputType="textPassword"
                android:background="@android:color/transparent"
                android:paddingBottom="8dp"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_marginBottom="4dp"
                android:drawablePadding="10dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#000000" />

            <!-- 오류 메시지 -->
            <TextView
                android:id="@+id/errorTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="잘못된 아이디 입니다. 다시 시도해주세요."
                android:textColor="#FF0000"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- 로그인 버튼 -->
            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Login"
                android:background="#1A1A1A"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <!-- 회원가입 -->
            <TextView
                android:id="@+id/registerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원가입"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>